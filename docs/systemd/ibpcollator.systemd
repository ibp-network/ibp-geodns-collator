[Unit]
Description=IBP GeoDNS Collator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ibp
Group=ibp
WorkingDirectory=/opt/ibp-geodns-collator

ExecStart=/opt/ibp-geodns-collator/bin/ibp-collator --config /etc/ibpdns/ibpcollator.json
Restart=on-failure
RestartSec=5s

Environment="SSL_CERT=/etc/letsencrypt/live/collator.example.org/fullchain.pem"
Environment="SSL_KEY=/etc/letsencrypt/live/collator.example.org/privkey.pem"

Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="GO_ENV=production"

[Install]
WantedBy=multi-user.target